{
  "name": "tree-sitter-moocode",
  "version": "0.2.0",
  "description": "Tree-sitter grammar for LambdaMOO/ToastStunt MOO code.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MongooseMoo/tree-sitter-moocode.git"
  },
  "main": "grammar.js",
  "type": "commonjs",
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "tree-sitter-moocode.wasm",
    "queries",
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./grammar.js",
    "./tree-sitter-moocode.wasm": "./tree-sitter-moocode.wasm",
    "./queries/folds.scm": "./queries/folds.scm",
    "./queries/highlights.scm": "./queries/highlights.scm",
    "./queries/locals.scm": "./queries/locals.scm",
    "./src/node-types.json": "./src/node-types.json"
  },
  "scripts": {
    "build:wasm": "tree-sitter build --wasm --output tree-sitter-moocode.wasm .",
    "generate": "tree-sitter generate",
    "test": "tree-sitter test",
    "parse": "tree-sitter parse",
    "roundtrip": "node scripts/roundtrip.mjs"
  },
  "keywords": [
    "tree-sitter",
    "moocode",
    "moo",
    "toaststunt",
    "lambdamoo"
  ],
  "license": "MIT",
  "devDependencies": {
    "tree-sitter-cli": "^0.26.9",
    "web-tree-sitter": "^0.26.13"
  },
  "tree-sitter": [
    {
      "scope": "source.moocode",
      "file-types": [
        "moo",
        "moocode"
      ]
    }
  ],
  "allowScripts": {
    "tree-sitter-cli@0.26.9": true
  }
}

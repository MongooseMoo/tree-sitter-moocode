{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "moocode",
      "camelcase": "MooCode",
      "scope": "source.moocode",
      "path": ".",
      "file-types": [
        "moo",
        "moocode"
      ]
    }
  ],
  "metadata": {
    "version": "0.3.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for LambdaMOO/ToastStunt MOO code.",
    "authors": [
      {
        "name": "Mongoose contributors"
      }
    ]
  },
  "bindings": {
    "c": true,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "go": false,
    "zig": false
  }
}
